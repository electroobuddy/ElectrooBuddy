NODE_ENV=development
HOST=0.0.0.0
PORT=3001
API_PREFIX=/api/v1
LOG_LEVEL=info

# PostgreSQL/Neon. Keep credentials server-side only.
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
DB_SSL=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Comma-separated exact origins. Never use * with credentialed requests.
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=1
REQUEST_BODY_LIMIT=1mb
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Prefer Neon's direct/unpooled URL for schema migrations when available.
# The API can continue using the pooled DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Phase 3 authentication. Use a random secret of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=electroobuddy-api
JWT_AUDIENCE=electroobuddy-web
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Auth email delivery. Production must use smtp; log is development/test only.
AUTH_DELIVERY_MODE=log
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ElectrooBuddy <no-reply@electroobuddy.local>

# Public catalog exposure allowlist
PUBLIC_SITE_SETTING_KEYS=phone_number,whatsapp_number,email,facebook_url,instagram_url,youtube_url,linkedin_url,x_url,address,business_hours

# Used only by catalog:sync-source; never expose in frontend.
# SOURCE_DATABASE_URL=postgresql://...

# Phase 5 S3-compatible object storage (Neon Object Storage / R2 / S3 / MinIO)
STORAGE_ENABLED=false
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://your-s3-compatible-endpoint.example.com
STORAGE_REGION=auto
STORAGE_BUCKET=images
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com/images
STORAGE_FORCE_PATH_STYLE=false
STORAGE_MAX_IMAGE_BYTES=5242880
STORAGE_UPLOAD_RATE_LIMIT_WINDOW_MS=900000
STORAGE_UPLOAD_RATE_LIMIT_MAX=30

# Phase 5 migration source. Temporary, server-side only.
# SOURCE_DATABASE_URL=postgresql://...
# MEDIA_MIGRATION_ALLOWED_HOSTS=legacy-storage.example.com

# Phase 6 browser refresh session. Refresh token is HttpOnly; frontend JS never stores it.
AUTH_REFRESH_COOKIE_NAME=electroobuddy_refresh
AUTH_REFRESH_COOKIE_SAME_SITE=lax
# For truly cross-site production frontend/API hosts use none (requires HTTPS).
AUTH_REFRESH_COOKIE_DOMAIN=


# Phase 11 native checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_QUOTE_TTL_MINUTES=20
CHECKOUT_MAX_ITEMS=50
CHECKOUT_MAX_QUANTITY_PER_PRODUCT=20
CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
CHECKOUT_RATE_LIMIT_MAX=20
TRACKING_RATE_LIMIT_WINDOW_MS=60000
TRACKING_RATE_LIMIT_MAX=20

# Phase 16 native Shiprocket fulfillment. Credentials are server-side only.
PUBLIC_API_URL=http://localhost:3001
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=

# Phase 18 — Native notification delivery
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep literal \\n sequences when stored in a single-line environment value.
FIREBASE_PRIVATE_KEY=
NOTIFICATION_WORKER_BATCH=25

# Phase 28 operations / worker monitoring
WORKER_LEASE_SECONDS=900
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_TIMEOUT_MS=5000
OPS_STALE_WORKER_MINUTES=30

# Guest (no-account) bookings. Set false until Turnstile keys are configured.
GUEST_BOOKING_RATE_LIMIT_WINDOW_MS=900000
GUEST_BOOKING_RATE_LIMIT_MAX=5
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
