# Phase 27 — production uses the same-origin Vercel proxy by default.
# Keep this relative in production so auth refresh cookies remain first-party.
VITE_API_BASE_URL=/api/v1

# Browser-side Razorpay public key only. Secrets belong on the API host.
VITE_RAZORPAY_KEY_ID=

# Vercel server-side environment variable (NOT a VITE_ variable).
# Configure this in the Vercel project; do not commit a real value.
# API_ORIGIN=https://api.example.com
